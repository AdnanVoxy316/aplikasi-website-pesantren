# Database (SQLite — development lokal)
DATABASE_URL=file:./data/elms.db

# BetterAuth
BETTER_AUTH_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
BETTER_AUTH_URL=http://localhost:3000

# Public app URL (untuk redirect & webhook)
APP_URL=http://localhost:3000

# Webhook publik untuk development (ngrok/cloudflared) — jangan hard-code di source
WEBHOOK_PUBLIC_URL=

# Midtrans — General Credentials.
# Sandbox: dashboard.sandbox.midtrans.com > Settings > Access Keys.
# Production: dashboard.midtrans.com > Settings > Access Keys, lalu set
# MIDTRANS_IS_PRODUCTION=true.
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# Opsional: batasi metode pembayaran yang muncul di halaman Snap.
# Kosongkan = semua metode aktif. Contoh:
# MIDTRANS_ENABLED_PAYMENTS=bca_va,bri_va,bni_va,mandiri_bill,qris,gopay
MIDTRANS_ENABLED_PAYMENTS=

# Gmail SMTP — kirim OTP & bukti pembayaran (opsional).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
